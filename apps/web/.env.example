# ─────────────────────────────────────────────────────────────────────────────
# promptduniya — website (BFF)
#
# The website holds NO database and NO gateway credentials. Everything is read
# and written through the API worker, so this file is deliberately short.
# API-side configuration (D1, R2, Razorpay, AI, email) lives in
# apps/api/.dev.vars locally and in `wrangler secret put` in production.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the API worker. Locally this is `wrangler dev` on apps/api.
# In production a service binding is used and this value is only a fallback.
API_BASE_URL=http://127.0.0.1:8787

# Must be byte-identical to the API's AUTH_SECRET: the website verifies access
# token signatures locally so resolving a session needs no network call.
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-me-with-at-least-16-characters

# Refresh-cookie lifetime in days. Keep in sync with the API's REFRESH_TOKEN_DAYS.
AUTH_SESSION_DAYS=30

# Shared with the API so /api/cron/maintenance can be triggered manually.
CRON_SECRET=

PRIMARY_DOMAIN=promptduniya.in
MAINTENANCE_MODE=false

# ---- Browser-visible values (inlined at build time) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=promptduniya
NEXT_PUBLIC_SITE_TAGLINE=Create Better. Imagine More.
NEXT_PUBLIC_ANALYTICS_ENABLED=true
NEXT_PUBLIC_ADS_ENABLED=false
# Publishable Razorpay key. The API reports the live key via /v1/catalog/brand;
# set this only if you want it inlined at build time.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
