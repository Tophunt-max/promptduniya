# ─────────────────────────────────────────────────────────────────────────────
# promptduniya — admin SPA
#
# The admin console holds no secrets. It authenticates against the API and keeps
# the access token in memory only; the refresh token is an httpOnly cookie set
# by the API, so nothing sensitive is ever written to browser storage.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the API worker. Must be an origin listed in the API's
# ADMIN_ORIGIN, otherwise CORS (and therefore the refresh cookie) will fail.
VITE_API_BASE_URL=http://127.0.0.1:8787
