# Security headers for the admin console.
# `connect-src` must include the API origin because the SPA calls it directly
# (cross-origin) — unlike the website, which proxies through its own origin.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Robots-Tag: noindex, nofollow
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://promptduniya-api.onlineilovegames.workers.dev; upgrade-insecure-requests

# Hashed asset filenames are safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
