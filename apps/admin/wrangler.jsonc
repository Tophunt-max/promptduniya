{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "promptduniya-admin",
  "compatibility_date": "2024-12-30",
  "observability": { "enabled": true },

  // A pure static-asset Worker: there is no `main`, so no server code runs.
  // `single-page-application` rewrites unknown paths to index.html, which is
  // what makes react-router deep links (e.g. /prompts/abc) resolve instead of
  // returning 404.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }

  // No bindings by design. The admin console holds no secrets and no data
  // access of its own — it authenticates against the API worker and every
  // request it makes is re-authorised there.
  //
  // Build-time configuration lives in Vite env vars (VITE_API_BASE_URL), which
  // are inlined into the bundle by `npm run build`.
}
