{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "promptduniya-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  // node:crypto, node:async_hooks (AsyncLocalStorage), Buffer, bcryptjs all need this.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // ---- D1 (relational database) ----
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "promptduniya",
      "database_id": "24a442ac-4f2d-415d-ae65-2eaba785dcd9",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],

  // ---- KV (rate limiting, sessions, settings cache) ----
  "kv_namespaces": [
    { "binding": "RATE_LIMIT", "id": "c685562cd88e4ab1bc460cb90ebe9225" },
    { "binding": "SESSIONS", "id": "990c4968662f44bf941bd78b72a8481d" },
    { "binding": "CACHE", "id": "64d4ac81e7524baebbd1c3bacc35efad" }
  ],

  // ---- R2 (media / uploads) ----
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "promptduniya-media" }
  ],

  // ---- Nightly maintenance (publish scheduled, trending, expiries) ----
  // 19:30 UTC == 01:00 IST, the platform's quiet hour.
  "triggers": {
    "crons": ["30 19 * * *"]
  },

  // ---- Non-secret vars. Secrets go via `wrangler secret put`. ----
  "vars": {
    "ENVIRONMENT": "production",
    "WEB_ORIGIN": "https://promptduniya-web.onlineilovegames.workers.dev",
    "ADMIN_ORIGIN": "https://promptduniya-admin.onlineilovegames.workers.dev",
    "PAYMENTS_MOCK_MODE": "true",
    "PAYMENTS_CURRENCY": "INR",
    "AI_PROVIDER": "template",
    "EMAIL_PROVIDER": "console",
    "EMAIL_FROM": "promptduniya <no-reply@promptduniya.in>",
    "R2_PUBLIC_URL": "https://pub-9b6fa93bd9db48c4ae3ed41d617ef06d.r2.dev"
  }

  // Secrets to set with `wrangler secret put <NAME>`:
  //   AUTH_SECRET, RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET,
  //   RAZORPAY_WEBHOOK_SECRET, AI_API_KEY, RESEND_API_KEY, CRON_SECRET
}
