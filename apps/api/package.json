{
  "name": "@pd/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "test": "vitest --run",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply promptduniya --local",
    "db:migrate:remote": "wrangler d1 migrations apply promptduniya --remote",
    "db:seed:generate": "tsx scripts/generate-seed-sql.ts",
    "db:seed:local": "npm run db:seed:generate && wrangler d1 execute promptduniya --local --file=./seed/seed.sql",
    "db:seed:remote": "npm run db:seed:generate && wrangler d1 execute promptduniya --remote --file=./seed/seed.sql",
    "db:setup:local": "npm run db:migrate:local && npm run db:seed:local",
    "db:setup:remote": "npm run db:migrate:remote && npm run db:seed:remote"
  },
  "dependencies": {
    "@pd/db": "*",
    "@pd/shared": "*",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.6.14",
    "jose": "^6.0.11",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260828.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.127.0"
  }
}
