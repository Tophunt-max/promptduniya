# dependencies
node_modules/
.pnp
.pnp.js

# builds
.next/
out/
dist/
build/
.open-next/
.wrangler/
*.tsbuildinfo

# next
next-env.d.ts

# generated by `wrangler types` — derives from local .env/.dev.vars and from
# .open-next/, so it is per-developer. Regenerate with `npm run cf-typegen`.
cloudflare-env.d.ts
worker-configuration.d.ts

# environment — never commit real secrets
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example

# generated from the TypeScript seed data — regenerate with db:seed:generate
apps/api/seed/seed.sql

# local databases
data/
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# testing
coverage/
.vitest/

# misc
.DS_Store
*.pem
.idea/
.vscode/*
!.vscode/extensions.json

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# uploads (local storage fallback)
apps/*/public/uploads/
