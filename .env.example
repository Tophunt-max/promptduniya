# ==========================================================================
# promptduniya — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ==========================================================================

# --------------------------------------------------------------------------
# Core
# --------------------------------------------------------------------------
NODE_ENV=development

# Public base URL of the site (no trailing slash). Used for canonical URLs,
# sitemap, Open Graph and webhook callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brand configuration (overridable at runtime from the admin settings panel)
NEXT_PUBLIC_SITE_NAME=promptduniya
NEXT_PUBLIC_SITE_TAGLINE=Create Better. Imagine More.

# Primary domain assumption for production (do not hard-code in code)
PRIMARY_DOMAIN=promptduniya.in

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
# Local development (libSQL / SQLite file):
DATABASE_URL=file:./data/promptduniya.db
# Production (Turso / libSQL server) example:
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token
DATABASE_AUTH_TOKEN=

# --------------------------------------------------------------------------
# Authentication
# --------------------------------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -base64 48
AUTH_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
# Session lifetime in days
AUTH_SESSION_DAYS=30
# bcrypt cost factor (10-12 recommended)
AUTH_BCRYPT_ROUNDS=12

# Optional Google OAuth (leave blank to disable the "Continue with Google" button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --------------------------------------------------------------------------
# Seed / bootstrap admin (used by `npm run db:seed` only)
# --------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@promptduniya.in
SEED_ADMIN_PASSWORD=ChangeMe!Admin123
SEED_ADMIN_NAME=Duniya Admin
SEED_DEMO_PASSWORD=ChangeMe!Demo123

# --------------------------------------------------------------------------
# Razorpay (payments) — server-side only, never expose the secret
# --------------------------------------------------------------------------
# The key id is safe to expose to the browser for Checkout.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Set to "true" to run the payment flow against a local mock provider
# (no network calls, useful for local dev and CI).
PAYMENTS_MOCK_MODE=true
PAYMENTS_CURRENCY=INR

# --------------------------------------------------------------------------
# AI provider for the prompt generator (optional)
# If unset, a deterministic template-based generator is used instead.
# --------------------------------------------------------------------------
AI_PROVIDER=template
AI_API_KEY=
AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_MODEL=gemini-2.0-flash

# --------------------------------------------------------------------------
# Object storage (Cloudflare R2 / any S3-compatible provider)
# If unset, uploads fall back to the local `public/uploads` directory.
# --------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=promptduniya-media
R2_PUBLIC_URL=

# --------------------------------------------------------------------------
# Email (transactional: verification, password reset, receipts)
# If unset, emails are logged to the server console instead of being sent.
# --------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM="promptduniya <no-reply@promptduniya.in>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# --------------------------------------------------------------------------
# Rate limiting
# In-memory by default (single instance). Provide Redis for multi-instance.
# --------------------------------------------------------------------------
RATE_LIMIT_DRIVER=memory
REDIS_URL=

# --------------------------------------------------------------------------
# Feature flags / analytics
# --------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_ENABLED=true
NEXT_PUBLIC_ADS_ENABLED=false
MAINTENANCE_MODE=false
